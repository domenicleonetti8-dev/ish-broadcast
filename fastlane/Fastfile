before_all do
    ensure_bundle_exec
end

desc "Build and upload broadcast to TestFlight without a Git workflow"
lane :broadcast_beta do
    team = ENV["APPLE_TEAM_ID"]
    UI.user_error!("APPLE_TEAM_ID is required") if team.to_s.empty?

    api_key = nil
    if ENV["APP_STORE_CONNECT_API_KEY_PATH"]
      if ENV["APP_STORE_CONNECT_KEY_ID"].to_s.empty?
        UI.user_error!("APP_STORE_CONNECT_KEY_ID is required")
      end
      if ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.empty?
        UI.user_error!("APP_STORE_CONNECT_ISSUER_ID is required")
      end
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      )
    end

    latest_options = { initial_build_number: 813 }
    latest_options[:api_key] = api_key if api_key
    latest = latest_testflight_build_number(**latest_options)
    increment_build_number(
      build_number: latest.to_i + 1,
      xcodeproj: "iSH.xcodeproj",
    )

    update_code_signing_settings(
      path: "iSH.xcodeproj",
      targets: "iSH",
      use_automatic_signing: true,
      team_id: team,
    )
    update_code_signing_settings(
      path: "iSH.xcodeproj",
      targets: "iSHFileProvider",
      use_automatic_signing: true,
      team_id: team,
    )
    build_app(
      project: "iSH.xcodeproj",
      scheme: "iSH",
      clean: true,
      export_method: "app-store",
      output_name: "broadcast.ipa",
      xcargs: "DEVELOPMENT_TEAM=#{team} -allowProvisioningUpdates",
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "broadcast.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Native broadcast routing, live finger status, and connection test.",
    )
end

lane :build do |options|
    team = ENV["APPLE_TEAM_ID"]
    UI.user_error!("APPLE_TEAM_ID is required") if team.to_s.empty?
    update_code_signing_settings(
      path: "iSH.xcodeproj",
      targets: "iSH",
      use_automatic_signing: true,
      team_id: team,
    )
    update_code_signing_settings(
      path: "iSH.xcodeproj",
      targets: "iSHFileProvider",
      use_automatic_signing: true,
      team_id: team,
    )

    config = options[:config]
    config = "app/#{config}.xcconfig" if config
    build_app(
      project: "iSH.xcodeproj",
      scheme: "iSH",
      xcconfig: config,
      xcargs: "DEVELOPMENT_TEAM=#{team} -allowProvisioningUpdates",
      output_name: options[:output],
    )
end

lane :upload_build do
    last_tag = `git describe --tags --abbrev=0 --match builds/\*`.chomp
    shortlog = `git shortlog #{last_tag}..HEAD`
    if shortlog.empty?
        UI.error "No commits since last build"
        next
    end
    changelog = "Automated daily build"
    testflight_changelog = changelog + "\n" + File.read("footer.txt") + shortlog

    app_store_connect_api_key
    latest = latest_testflight_build_number.to_s.scan(/^\d+(?=\.|$)/).first.to_i
    build_number = latest + 1
    Dir.chdir("..") do
        sh "agvtool", "new-version", build_number.to_s
    end
    commit_version_bump(
        xcodeproj: "iSH.xcodeproj",
        message: "Bump version to #{build_number}",
        force: true,
    )
    tag = "builds/#{build_number}"
    add_git_tag(tag: tag)

    build
    puts testflight_changelog
    upload_to_testflight(
        ipa: "iSH.ipa",
        changelog: testflight_changelog,
        wait_processing_interval: 300, # the processing is expected to take a total of 5 hours, so don't logspam too much
        distribute_external: true,
        groups: ["People"],
    )

    # uploading a build takes about 5 hours, so merge master back in if there have been any commits during that
    sh "git pull --no-rebase"
    push_to_git_remote
    set_github_release(
        repository_name: "ish-app/ish",
        tag_name: tag,
        commitish: nil, # the tag better exist
        name: "Build #{build_number}",
        description: changelog,
        is_prerelease: true,
        upload_assets: ["iSH.ipa", "iSH.app.dSYM.zip"],
        api_token: ENV["GH_TOKEN"],
    )
end
