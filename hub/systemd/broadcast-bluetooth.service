[Unit]
Description=Broadcast Bluetooth endpoint and speaker reconnect service
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
RuntimeDirectory=broadcast-hub
RuntimeDirectoryMode=0755
ExecStartPre=/usr/local/lib/broadcast-hub/prepare-controller-class.sh /etc/broadcast-hub/config.json
ExecStart=/usr/bin/python3 /usr/local/lib/broadcast-hub/broadcast_bluez.py --config /etc/broadcast-hub/config.json
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
