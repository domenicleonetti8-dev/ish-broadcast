[Unit]
Description=EIRA2 Orin Build Probe Durable Supervisor V3
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/media/domenicleonetti/easystore/EIRA/LIVE
ExecStart=/usr/bin/python3 /media/domenicleonetti/easystore/EIRA/LIVE/eira_probe/eira2_orin_build_probe_supervisor_v3.py
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
